rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function validId(c) { return c.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'); }
  function camp(c) { return get(/databases/$(database)/documents/campShared/$(c)).data; }
  function member(c) { return validId(c) && exists(/databases/$(database)/documents/campShared/$(c)); }
  function leader(c) { return member(c); }
  function finance(c) { return member(c); }
  // Only manually approved Google accounts may enumerate camp IDs.
  function directoryReader() { return request.auth != null && request.auth.token.email_verified == true
   && exists(/databases/$(database)/documents/campDirectoryReaders/$(request.auth.uid))
   && get(/databases/$(database)/documents/campDirectoryReaders/$(request.auth.uid)).data.enabled == true; }
  function str(v,n) { return v is string && v.size() <= n; }
  function money(v) { return v is int && v >= 0 && v <= 100000000; }
  function revision() { return request.resource.data.updatedAt == request.time && request.resource.data.revision == (resource == null ? 1 : resource.data.revision+1); }
  // 管理者権限はFirebase管理者だけが設定。共有リンクの識別子や画面のフラグを認証に使わない。
  function specialAdmin(c) { return request.auth!=null && request.auth.token.email_verified==true && member(c)
   && get(/databases/$(database)/documents/campSpecialAdmins/$(request.auth.uid)).data.enabled==true
   && get(/databases/$(database)/documents/campSpecialAdmins/$(request.auth.uid)).data.camps.get(c,false)==true; }
  function specialPublic(d) { return d.keys().hasOnly(['id','revision','kind','title','amountMode','unit','quantity','amount','confirmedAmount','due','status','funding','owner','flow','use','includeBudget','eligibilityVerified','ownershipVerified','consentVerified','budgetAnchor','entryIds','discountActual'])
   && str(d.id,80) && d.id.matches('[A-Za-z0-9_-]{1,80}') && d.revision is int && d.revision>=1
   && d.kind in ['expense','aid'] && str(d.title,80) && d.title.size()>0 && d.amountMode in ['unit','total']
   && (d.unit==null || money(d.unit)) && (d.quantity==null || (d.quantity is int && d.quantity>=0 && d.quantity<=10000)) && (d.amount==null || money(d.amount))
   && (d.confirmedAmount==null || money(d.confirmedAmount)) && (d.unit==null || d.quantity==null || d.unit*d.quantity<=100000000)
   && str(d.due,10) && d.status in ['planned','checking','confirmed','settled','cancelled'] && d.funding in ['unknown','team','pool','individual','other']
   && d.owner in ['unknown','camp','personal'] && d.flow in ['cash','discount'] && (d.kind!='expense' || d.flow=='cash')
   && d.use in ['all','players','hotel','transport','leisure','reserve'] && d.includeBudget is bool && d.eligibilityVerified is bool && d.ownershipVerified is bool && d.consentVerified is bool
   && (!d.includeBudget || (d.owner=='camp' || (d.owner=='personal' && d.kind=='aid' && d.consentVerified && d.flow=='cash')))
   && d.entryIds is list && d.entryIds.size()<=100 && d.entryIds.toSet().size()==d.entryIds.size()
   && (d.budgetAnchor==null || (d.budgetAnchor is map && d.budgetAnchor.keys().hasOnly(['source','id','revision','total','basis']) && d.budgetAnchor.source in ['budgets','budgetLines'] && str(d.budgetAnchor.id,150) && d.budgetAnchor.revision is int && (d.budgetAnchor.total==null || money(d.budgetAnchor.total)) && d.budgetAnchor.basis in ['gross','net']))
   && (d.discountActual==null || (d.discountActual is map && d.discountActual.keys().hasOnly(['amount','entryId','entryAmount','basis','referenceKey']) && money(d.discountActual.amount) && str(d.discountActual.entryId,100) && money(d.discountActual.entryAmount) && d.discountActual.basis in ['gross','net'] && d.discountActual.referenceKey.matches('[a-f0-9]{64}'))); }
  function specialAllocation(d) { return d is map && d.keys().hasOnly(['members','team','leisure','reserve','confirmed']) && money(d.members) && money(d.team) && money(d.leisure) && money(d.reserve) && d.confirmed is bool; }
  function specialDetails(d) { return d is map && d.keys().hasOnly(['schemeName','applicationBasis','beneficiaries','payer','recipient','ownershipEvidence','consentEvidence','verification','discountReference','note'])
   && str(d.schemeName,3000) && str(d.applicationBasis,3000) && str(d.beneficiaries,3000) && str(d.payer,3000) && str(d.recipient,3000) && str(d.ownershipEvidence,3000) && str(d.consentEvidence,3000) && str(d.verification,3000) && str(d.discountReference,3000) && str(d.note,3000); }
  // Firebase Console administrators create/revoke these approvals; clients cannot write them.
  match /campDirectoryReaders/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }
  match /campSpecialAdmins/{u} { allow get: if request.auth!=null && request.auth.uid==u; allow list,write: if false; }
  match /campSpecialPrivate/{c}/items/{i} {
   allow read: if specialAdmin(c);
   allow create,update: if specialAdmin(c) && revision() && request.resource.data.keys().hasOnly(['public','details','revision','actor','lastOperation','signature','updatedAt'])
    && request.resource.data.actor==request.auth.uid && str(request.resource.data.lastOperation,100) && str(request.resource.data.signature,60000)
    && specialPublic(request.resource.data.public) && request.resource.data.public.id==i && request.resource.data.public.revision==request.resource.data.revision
    && specialDetails(request.resource.data.details)
    && (resource==null || request.resource.data.public.kind==resource.data.public.kind)
    && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(i+'__'+string(request.resource.data.revision))).data.after==request.resource.data
    && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(i+'__'+string(request.resource.data.revision))).data.before==(resource==null?null:resource.data)
    && getAfter(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.items[i]==request.resource.data.public;
   allow delete: if false;
  }
  match /campSpecialPrivate/{c}/history/{h} {
   allow read: if specialAdmin(c);
   allow create: if specialAdmin(c) && request.resource.data.keys().hasOnly(['itemId','before','after','actor','updatedAt']) && request.resource.data.actor==request.auth.uid && request.resource.data.updatedAt==request.time
    && str(request.resource.data.itemId,80) && (request.resource.data.itemId=='allocation' || request.resource.data.after.public.id==request.resource.data.itemId);
   allow update,delete: if false;
  }
  match /campShared/{c}/specialItems/{i} {
   allow read: if member(c);
   allow create,update: if member(c) && revision() && request.resource.data.keys().hasOnly(['public','details','revision','actor','lastOperation','signature','updatedAt'])
    && str(request.resource.data.actor,128) && str(request.resource.data.lastOperation,100) && str(request.resource.data.signature,60000)
    && (resource!=null || !exists(/databases/$(database)/documents/campShared/$(c)/specialBook/current) || !(i in get(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.get('items',{}))) && specialPublic(request.resource.data.public) && request.resource.data.public.id==i && request.resource.data.public.revision==request.resource.data.revision
    && specialDetails(request.resource.data.details) && request.resource.data.details.values().toSet()==[''].toSet()
    && (resource==null || request.resource.data.public.kind==resource.data.public.kind)
    && getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(i+'__'+string(request.resource.data.revision))).data.after==request.resource.data
    && getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(i+'__'+string(request.resource.data.revision))).data.before==(resource==null?null:resource.data)
    && getAfter(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.items[i]==request.resource.data.public;
   allow delete: if false;
  }
  match /campShared/{c}/specialHistory/{h} {
   allow read: if member(c);
   allow create: if member(c) && request.resource.data.keys().hasOnly(['itemId','before','after','actor','updatedAt']) && str(request.resource.data.actor,128) && request.resource.data.updatedAt==request.time
    && str(request.resource.data.itemId,80) && (request.resource.data.itemId=='allocation' ? (getAfter(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.historyId==h && request.resource.data.after==getAfter(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.allocation && request.resource.data.before==get(/databases/$(database)/documents/campShared/$(c)/specialBook/current).data.allocation) : (request.resource.data.after==getAfter(/databases/$(database)/documents/campShared/$(c)/specialItems/$(request.resource.data.itemId)).data && request.resource.data.before==(exists(/databases/$(database)/documents/campShared/$(c)/specialItems/$(request.resource.data.itemId))?get(/databases/$(database)/documents/campShared/$(c)/specialItems/$(request.resource.data.itemId)).data:null)));
   allow update,delete: if false;
  }
  match /campShared/{c} {
   function meta() { let d=request.resource.data;
    return d.keys().hasOnly(['name','start','end','place','meeting','fee','status','notes','archived','revision','updatedAt'])
     && str(d.name,150) && d.name.size()>0 && str(d.start,10) && str(d.end,10) && d.start<=d.end
     && str(d.place,500) && str(d.meeting,500) && money(d.fee) && str(d.notes,5000)
     && d.status in ['準備中','募集中','実施中','終了','精算完了'] && d.archived is bool
     && d.updatedAt==request.time;
   }
   allow get: if validId(c);
   allow list: if directoryReader();
   allow create: if validId(c) && meta() && request.resource.data.revision==0;
   allow update: if leader(c) && meta() && request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
   match /specialBook/current {
    function validBook() { let d=request.resource.data;let previous=resource==null?{}:resource.data.items;
     return d.keys().hasOnly(['items','allocation','revision','lastItemId','historyId','updatedAt']) && d.items is map && d.items.size()<=100 && specialAllocation(d.allocation) && str(d.lastItemId,80) && str(d.historyId,150)
      && (d.lastItemId=='' ? d.items==previous : (d.items.diff(previous).affectedKeys().hasOnly([d.lastItemId]) && specialPublic(d.items[d.lastItemId]) && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/items/$(d.lastItemId)).data.public==d.items[d.lastItemId]))
      && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(d.historyId)).data.updatedAt==request.time
      && (d.lastItemId=='' ? (getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(d.historyId)).data.itemId=='allocation' && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(d.historyId)).data.before==resource.data.allocation && getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(d.historyId)).data.after==d.allocation) : getAfter(/databases/$(database)/documents/campSpecialPrivate/$(c)/history/$(d.historyId)).data.after.public==d.items[d.lastItemId]);
    }
    function validSharedBook() { let d=request.resource.data;let previous=resource==null?{}:resource.data.items;
     return d.keys().hasOnly(['items','allocation','revision','lastItemId','historyId','updatedAt']) && d.items is map && d.items.size()<=100 && specialAllocation(d.allocation) && str(d.lastItemId,80) && str(d.historyId,150)
      && (d.lastItemId=='' ? d.items==previous : (d.items.diff(previous).affectedKeys().hasOnly([d.lastItemId]) && specialPublic(d.items[d.lastItemId]) && getAfter(/databases/$(database)/documents/campShared/$(c)/specialItems/$(d.lastItemId)).data.public==d.items[d.lastItemId]))
      && getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(d.historyId)).data.updatedAt==request.time
      && (d.lastItemId=='' ? (getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(d.historyId)).data.itemId=='allocation' && getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(d.historyId)).data.before==resource.data.allocation && getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(d.historyId)).data.after==d.allocation) : getAfter(/databases/$(database)/documents/campShared/$(c)/specialHistory/$(d.historyId)).data.after.public==d.items[d.lastItemId]);
    }
    allow get: if member(c);allow list: if false;
    allow create,update: if revision() && ((specialAdmin(c) && validBook()) || (member(c) && validSharedBook()));allow delete: if false;
   }
   match /participants/{p} {
    function valid() { let d=request.resource.data;
     return d.keys().hasOnly(['name','grade','kind','familyUid','response','overnight','revision','updatedAt'])
      && str(d.name,100) && d.name.size()>0 && str(d.grade,100) && str(d.familyUid,128)
      && d.kind in ['player','coach','parent','other'] && d.response in ['pending','yes','no'] && d.overnight is bool && revision();
    }
    allow read: if member(c);
    allow create: if leader(c) && valid();
    allow update: if valid() && member(c);
    allow delete: if false;
   }
   match /routes/{r} {
    allow read: if member(c);
    allow create,update: if leader(c) && revision() && request.resource.data.keys().hasOnly(['date','time','title','address','mapLink','notes','archived','revision','updatedAt'])
     && str(request.resource.data.date,10) && request.resource.data.date>=camp(c).start && request.resource.data.date<=camp(c).end
     && str(request.resource.data.time,5) && str(request.resource.data.title,150) && str(request.resource.data.address,500)
     && str(request.resource.data.mapLink,2000) && (request.resource.data.mapLink=='' || request.resource.data.mapLink.matches('https://.*'))
     && str(request.resource.data.notes,3000) && request.resource.data.archived is bool;
   }
   match /budgets/{b} {
    allow read: if member(c);
    allow create,update: if finance(c) && revision() && request.resource.data.keys().hasOnly(['title','unit','quantity','notes','archived','revision','updatedAt'])
     && str(request.resource.data.title,150) && money(request.resource.data.unit) && request.resource.data.quantity is int
     && request.resource.data.quantity>=0 && request.resource.data.quantity<=10000 && str(request.resource.data.notes,1000) && request.resource.data.archived is bool;
   }
   // 旧budgetsと台帳をそのまま残す、予算書の追加領域。
   function budgetFields(d) {
    return str(d.title,150) && d.title.size()>0 && str(d.notes,1000)
     && d.kind in ['expense','income','feeChild','feeAdult','feeParent','feeCoach','feeOther']
     && d.category in ['hotel','meal','leisure','transport','insurance','supplies','reserve','support','other','participation']
     && d.target in ['all','players','adults','parents','coaches','others','transport']
     && d.quantityMode in ['manual','players','adults','parents','coaches','others','playersOvernight','adultsOvernight','parentsOvernight','coachesOvernight','othersOvernight','all']
     && (d.unit==null || money(d.unit)) && (d.quantity==null || (d.quantity is int && d.quantity>=0 && d.quantity<=10000))
     && d.get('basis','person') in ['person','room','fixed'] && d.get('multiplier',1) is int && d.get('multiplier',1)>=1 && d.get('multiplier',1)<=100
     && (d.get('basis','person')=='person' || d.quantityMode=='manual')
     && (d.unit==null || d.quantity==null || d.unit*d.quantity*d.get('multiplier',1)<=100000000) && d.archived is bool
     && (d.kind!='expense' || d.target!='transport')
     && (d.kind!='feeChild' || (d.target=='players' && d.category=='participation'))
     && (d.kind!='feeAdult' || (d.target=='adults' && d.category=='participation'))
     && (d.kind!='feeParent' || (d.target=='parents' && d.category=='participation'))
     && (d.kind!='feeCoach' || (d.target=='coaches' && d.category=='participation'))
     && (d.kind!='feeOther' || (d.target=='others' && d.category=='participation'))
     && (!(d.kind in ['feeChild','feeAdult','feeParent','feeCoach','feeOther']) || (d.get('basis','person')=='person' && d.get('multiplier',1)==1))
     && (d.kind in ['feeChild','feeAdult','feeParent','feeCoach','feeOther'] || d.category!='participation');
   }
   match /budgetLines/{b} {
    allow read: if member(c);
    allow create,update: if finance(c) && revision() && budgetFields(request.resource.data)
     && request.resource.data.keys().hasOnly(['title','kind','category','target','quantityMode','unit','quantity','notes','archived','basis','multiplier','revision','updatedAt']);
    allow delete: if false;
   }
   // 読み取り可否だけで料金拡張ルールを検知する予約領域。書込みは許可しない。
   match /private/budgetRates {
    allow get: if member(c);
    allow list,create,update,delete: if false;
   }
   match /private/budgetSettings {
    allow read: if member(c);
    allow create,update: if finance(c) && revision()
     && request.resource.data.keys().hasOnly(['rounding','revision','updatedAt'])
     && request.resource.data.rounding in [1,10,100,500,1000];
    allow delete: if false;
   }
   match /settlementDrafts/{b} {
    function originMatches(d) {
     let src=get(/databases/$(database)/documents/campShared/$(c)/$(d.sourceCollection)/$(d.sourceId)).data;
     return src.revision==d.sourceRevision && src.archived==false && src.title==d.title && src.unit==d.unit && src.quantity==d.quantity && src.notes==d.notes && src.get('basis','person')==d.get('basis','person') && src.get('multiplier',1)==d.get('multiplier',1)
      && ((d.sourceCollection=='budgets' && d.kind=='expense' && d.category=='other' && d.target=='all' && d.quantityMode=='manual')
       || (d.sourceCollection=='budgetLines' && src.kind==d.kind && src.category==d.category && src.target==d.target && src.quantityMode==d.quantityMode));
    }
    allow read: if member(c);
    allow create,update: if finance(c) && revision() && budgetFields(request.resource.data)
     && request.resource.data.keys().hasOnly(['title','kind','category','target','quantityMode','unit','quantity','notes','archived','sourceId','sourceCollection','sourceRevision','zeroConfirmed','confirmedLedgerRevision','basis','multiplier','revision','updatedAt'])
     && request.resource.data.sourceCollection in ['budgets','budgetLines'] && str(request.resource.data.sourceId,150)
     && b==((request.resource.data.sourceCollection=='budgets'?'legacy_':'line_')+request.resource.data.sourceId)
     && request.resource.data.get('confirmedLedgerRevision',-1) is int && request.resource.data.get('confirmedLedgerRevision',-1)>=-1
     && request.resource.data.sourceRevision is int && request.resource.data.sourceRevision>=1 && request.resource.data.zeroConfirmed is bool
     && ((resource!=null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zeroConfirmed','confirmedLedgerRevision','revision','updatedAt']))
      || (originMatches(request.resource.data) && (resource==null || request.resource.data.kind==resource.data.kind)));
    allow delete: if false;
   }
   match /private/ledger {
    allow read: if finance(c);
    allow create,update: if finance(c) && revision() && request.resource.data.keys().hasOnly(['revision','charges','entries','history','updatedAt'])
     && request.resource.data.charges is map && request.resource.data.charges.size()<=1000 && request.resource.data.entries is map && request.resource.data.entries.size()<=1000
     && request.resource.data.history is map && request.resource.data.history.size()<=2000
     && (resource==null || (request.resource.data.history.diff(resource.data.history).removedKeys().size()==0 && request.resource.data.history.diff(resource.data.history).changedKeys().size()==0))
     && getAfter(/databases/$(database)/documents/campShared/$(c)/public/finance).data.revision==request.resource.data.revision;
   }
   match /public/finance {
    allow read: if member(c);
    allow create,update: if finance(c) && request.resource.data.updatedAt==request.time
     && request.resource.data.keys().hasOnly(['billed','received','due','credit','rate','income','expense','balance','advances','revision','unpaid','categories','updatedAt'])
     && request.resource.data.unpaid is list && request.resource.data.categories is map
     && getAfter(/databases/$(database)/documents/campShared/$(c)/private/ledger).data.revision==request.resource.data.revision;
   }
  }
 }
}
